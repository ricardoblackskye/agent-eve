{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "incremental": true
  },
  "include": [
    "agent/**/*.ts",
    "evals/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "next-env.d.ts"
  ],
  "exclude": ["node_modules"]
}