# Copy this file to `.env.local` and fill in the values.
# `cp .env.example .env.local`
#
# Only `.env.example` is committed. Never commit a real `.env.local` —
# `.gitignore` excludes every `.env*` file except this one.
#
# In production these are set as Vercel environment variables
# (Project Settings -> Environment Variables), NOT in a file. Sensitive
# values are masked in Vercel and cannot be read back with `vercel env pull`.

# ---------------------------------------------------------------------------
# GitHub integration
# ---------------------------------------------------------------------------

# Personal access token used to write to the repository.
#
# Required permissions — BOTH are needed:
#   - Contents: Read and write   (Release Manager writes `releasenotes.md`)
#   - Issues:   Read and write   (Product Owner creates story issues and posts
#                                 clarifying comments)
#
# A Contents-only token returns HTTP 403 when creating issues or comments.
#
# Classic PAT: `public_repo` covers both on a public repository
#              (`repo` for private repositories).
# Fine-grained PAT: select BOTH "Contents: Read and write" AND
#              "Issues: Read and write" — they are separate entries and
#              selecting only Contents is the usual mistake.
#
# Verify before deploying (does not print the token, only its scopes):
#   curl -sI -H "Authorization: Bearer $GH_RELEASE_TOKEN" \
#        https://api.github.com/rate_limit | grep -i x-oauth-scopes
# A fine-grained PAT returns a 200 with no `x-oauth-scopes` header; check it
# under GitHub -> Settings -> Developer settings -> Fine-grained tokens.
GH_RELEASE_TOKEN=

# Token the Product Owner uses to CREATE `[Story]` issues (and post the
# cross-reference comment on the source issue). Read BEFORE GH_RELEASE_TOKEN
# and GITHUB_TOKEN — so a story-only token can be scoped to `issues: write`
# without granting repo Contents access. Needs `issues: read and write`.
GH_STORY_TOKEN=

# Final fallback token if neither GH_RELEASE_TOKEN nor GH_STORY_TOKEN is set.
# SAME permission requirements as GH_RELEASE_TOKEN above.
GITHUB_TOKEN=

# Optional env override for the default publish target. When set, story
# publishing falls back to this owner/repo if the webhook payload does not
# supply an explicit source owner/repo. Must be a clean GitHub identifier
# (alphanumerics, hyphens for owner; alphanumerics, `.`, `_`, `-` for repo).
# If the env value is stripped to empty by sanitisation, the literal default
# "ricardoblackskye" / the webhook-supplied value is used instead (a warning
# is emitted so a misconfiguration is not silent).
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Comma-separated allow-list of `owner/repo` targets that story publishing is
# PERMITTED to write to. CONFIG (not a secret) — values are public repo names.
#
# FAIL-CLOSED: if this is unset or empty, publishing is REFUSED with zero API
# calls (mode: "blocked"). A misconfigured/unconfigured deployment therefore
# cannot silently publish to an arbitrary repo. Comparison is
# case-insensitive on BOTH owner and repo (GitHub treats both as
# case-insensitive).
#
# Example (the two repos this agent is currently allowed to publish to):
#   STORY_ALLOWED_REPOS=ricardoblackskye/agent-eve,ricardoblackskye/WebFeedPOC
STORY_ALLOWED_REPOS=

# Shared secret that authenticates incoming GitHub webhook payloads.
# Must match the secret configured on the webhook in GitHub repo Settings.
#
# REQUIRED in deployed environments. If this is unset on Vercel
# (VERCEL_ENV=production or preview), the webhook handler refuses to process
# requests and returns HTTP 500 — an unset secret previously bypassed
# signature verification and accepted forged payloads. Leaving it empty is
# only permitted for local development.
#
# Also needed as a GitHub Actions SECRET (not a variable) for the
# production-evals job: production rejects unsigned webhooks with 401, so the
# eval suite signs its requests with this value. Without it those evals skip
# the happy-path webhook assertions rather than fail.
GH_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Agent runtime
# ---------------------------------------------------------------------------

# Bearer token required by the Eve API. When unset the agent falls back to
# local dev / OIDC auth.
EVE_API_KEY=

# OpenRouter key powering the model. When unset the agent falls back to a
# deterministic mock model so local development and evals need no key.
OPENROUTER_API_KEY=

# Optional: override the root chat model id (defaults to deepseek/deepseek-v4.1-flash).
EVE_CHAT_MODEL=deepseek/deepseek-v4.1-flash

# Optional: model id used by subagents that resolve their own model (e.g. the
# Sprint Metrics Analyst). Defaults to deepseek/deepseek-v4.1-flash when unset.
# NOT used by the PR-reviewer — see PR_REVIEW_MODEL below. CONFIG (not a secret).
MODEL_NAME=deepseek/deepseek-v4.1-flash

# Client-side Eve API key for the chat widget.
#
# WARNING — PUBLIC BY DESIGN, NOT A SECRET. Any NEXT_PUBLIC_* variable is
# inlined into the browser JavaScript bundle and is readable by anyone who
# visits the site. Do NOT mark this Sensitive and do NOT reuse a key that
# protects anything beyond this proxy.
#
# What it actually is: the key the chat UI sends as `Authorization: Bearer <key>`
# to YOUR OWN `/api/eve` proxy. That proxy requires `Bearer ${EVE_API_KEY}`
# to even reach the agent (app/api/eve/v1/[...slug]/route.ts), so in practice
# this value must EQUAL the server-side EVE_API_KEY for the widget to work.
# It does NOT grant GitHub or OpenRouter access — an extracted key only lets a
# visitor call your own deployed agent through your own proxy (your compute +
# OpenRouter quota). Mitigate abuse with proxy rate-limiting and Vercel
# Protection, not key separation.
NEXT_PUBLIC_EVE_API_KEY=

# ---------------------------------------------------------------------------
# Vercel
# ---------------------------------------------------------------------------

# Vercel Protection Bypass secret. When a deployment uses Vercel Protection
# (password / SSO / signed-bypass), this header value lets server-to-server
# calls (e.g. the proxy route, evals against the deployed URL) reach the app.
# SECRET — mark Sensitive in Vercel. Leave empty for unprotected deployments.
VERCEL_PROTECTION_BYPASS=

# ---------------------------------------------------------------------------
# Optional: user-story generation overrides
# ---------------------------------------------------------------------------

# Mention that triggers the Product Owner when it appears in a new issue body.
EVE_STORY_MENTION=@eve-agent

# Label that triggers the Product Owner when applied to an issue.
EVE_STORY_LABEL=needs-story

# ---------------------------------------------------------------------------
# Sprint Metrics Report (label an issue `generate-sprint-report`)
# ---------------------------------------------------------------------------

# Token the Sprint Metrics Analyst uses to READ the GitHub Projects V2 board.
# Needs the `read:project` scope (classic PAT) or "Projects: read-only" fine-
# grained permission. SECRET — mark Sensitive in Vercel. If unset, the report
# step falls back to GH_RELEASE_TOKEN / GITHUB_TOKEN.
GH_SPRINT_TOKEN=

# Override the Projects V2 board the report reads. Defaults to the user
# project `ricardoblackskye` #3.
SPRINT_PROJECT_OWNER=ricardoblackskye
SPRINT_PROJECT_NUMBER=3

# ---------------------------------------------------------------------------
# CI / PR reviewer (GitHub Actions)
# ---------------------------------------------------------------------------

# Optional: cap on the diff characters sent to the PR-reviewer LLM
# (scripts/pr-reviewer.js). Defaults to 20000 when unset. Raise for very large
# PRs, lower to cut token cost. CONFIG (not a secret).
PR_REVIEW_MAX_DIFF_CHARS=20000

# Optional: model id for the PR-reviewer LLM call. Deliberately NOT the project
# default: that model is a REASONING model whose chain-of-thought can consume the
# entire completion budget and return NO content, silently degrading the review to
# a structural stub (#87). Measured on a 14k-char diff, deepseek-v4.1-flash
# returned finish_reason="length" with zero content under a token cap, under
# reasoning.effort="low", and with no cap at all — and its reasoning GREW with the
# budget, so raising PR_REVIEW_MAX_TOKENS only moves the wall. A non-reasoning
# model cannot fail this way. Defaults to deepseek/deepseek-chat.
# CONFIG (not a secret).
PR_REVIEW_MODEL=deepseek/deepseek-chat

# Optional: total completion budget for the PR-reviewer call. Defaults to 6000.
# Mainly relevant if you override PR_REVIEW_MODEL with a reasoning model, in which
# case set it comfortably above that model's observed reasoning length.
# CONFIG (not a secret).
PR_REVIEW_MAX_TOKENS=6000

# Optional: reasoning-token cap sent with the request. NOTE: measured as
# INEFFECTIVE on deepseek-v4.1-flash (it emitted ~22.6k chars of reasoning despite
# a 1500-token cap); kept only as a hint for reasoning-model overrides.
# Defaults to 1500.
PR_REVIEW_REASONING_MAX_TOKENS=1500

# Optional: enable self-correction verification and false-positive filtering for
# PR reviews. Purges runtime hallucinations (e.g. Node.js thread-safety claims)
# and downgrades or clears pedantic comments. Set to "0" to disable.
# Defaults to "1" (enabled). CONFIG (not a secret).
PR_REVIEW_VERIFY=1

# ---------------------------------------------------------------------------
# Dark Factory R1 — state, dispatch, observability (#134 / #138 / #140)
# ---------------------------------------------------------------------------
#
# Eve is stateless between requests, so the delivery loop keeps its execution
# memory in an EXTERNAL store. These knobs are fail-closed: an unset driver
# makes the seam REFUSE rather than pretend it persisted anything.
#
# Execution-memory store (current issue, assigned worker, last test outcome,
# delivery-loop step). Unset -> refusing `console` default. `sqlite` ->
# file-backed adapter. Any other value is a configuration error.
DF_STATE_DRIVER=
# Required when DF_STATE_DRIVER=sqlite: filesystem path to the SQLite file.
# A Vercel serverless filesystem is ephemeral, so this proves real external-
# state semantics locally and in CI but does NOT survive cold starts;
# production persistence needs Redis/pgvector (a later release).
DF_STATE_DB_PATH=
# Optional sandbox root (defence in depth). When set, DF_STATE_DB_PATH must
# resolve INSIDE this directory — an escaping path is refused at boot rather
# than silently used (same fail-closed shape as STORY_ALLOWED_REPOS). A symlink
# or junction inside the root that points outside it is refused too: the REAL
# path of the deepest existing ancestor is checked, so an escape cannot hide
# behind a link (#160). Unset trusts the operator, who already controls the
# environment.
DF_STATE_DB_DIR=
# Dispatch retry policy. Defaults: 2 retries, 1000ms base delay, x3 backoff.
# Plain digits only, within 0..100 retries and 0..3600000ms base delay — a
# value in scientific notation or hex, whitespace-padded, or outside the range
# is rejected at boot rather than defaulted (#160).
DF_DISPATCH_MAX_RETRIES=
DF_DISPATCH_BASE_DELAY_MS=
# Observability store. Unset or `memory` -> in-process store. Failed writes are
# surfaced and buffered for retry, never dropped silently.
DF_METRICS_DRIVER=

# ---------------------------------------------------------------------------
# Dark Factory R2 — worker environment + credential boundary (#135 / #142)
# ---------------------------------------------------------------------------
#
# Where the worker sandbox runs. Unset or `local` -> the R2 dry-run provider,
# which reports isolated:false and executes NOTHING (it reports what it would
# do). The e2b/modal adapters land once keys exist; any other value is rejected.
DF_WORKER_PROVIDER=
# Repos a worker task may target (comma-separated `owner/repo`). FAIL-CLOSED:
# unset means NO repo is permitted and every task is refused with 403 BEFORE a
# sandbox is provisioned. Deliberately kept separate from STORY_ALLOWED_REPOS so
# the two blast radii stay independent.
DF_WORKER_ALLOWED_REPOS=
# Runtime requested inside the worker environment: `node` | `python` (default node).
DF_WORKER_RUNTIME=
# Lifetime of the per-task credential lease in seconds (1..3600, default 3600).
# The worker receives a LEASE only; the repository token stays in the broker.
DF_CREDENTIAL_TTL_SECONDS=
# Where worker progress/completion/questions are reported (#162). Unset or
# `console` -> the dry-run provider: it renders the comment locally and writes
# NOTHING. `github` posts real issue comments using GH_STORY_TOKEN /
# GH_RELEASE_TOKEN / GITHUB_TOKEN, and is gated by DF_WORKER_ALLOWED_REPOS above —
# a repo outside that list is REFUSED before any call is made. The reporter runs
# in the orchestrator's process; the worker sandbox never holds a token.
DF_REPORTER_PROVIDER=

# ---------------------------------------------------------------------------
# Dark Factory R5 — kick-off trigger + entry point (#163)
# ---------------------------------------------------------------------------
#
# The label that requests autonomous work. Applying it to an issue in an
# allow-listed repo, by an allow-listed actor, records a dispatch and hands it off
# out of band. Removing it ABORTS the run. Unset -> `dark-factory`.
DF_TRIGGER_LABEL=
# Who may request work (comma-separated GitHub logins). FAIL-CLOSED: unset means NO
# actor is permitted and every trigger is REFUSED. On a public repo anyone can apply
# a label, so this is the gate that stops the trigger being forgeable.
DF_TRIGGER_ALLOWED_USERS=
# Where the work runs. Unset/`session` -> the deployed path. `local` routes to the
# in-process runner for laptop testing, and is REFUSED in any production build
# (Vercel's or self-hosted) so a local flag can never become a production bypass.
DF_RUNNER=

# ---------------------------------------------------------------------------
# Dark Factory R3 — factory-level circuit breaker / cost guard (#144)
# ---------------------------------------------------------------------------
#
# Cross-task safety guard that caps cumulative worker-minutes per PBI and
# escalates after a configured number of failed self-correct cycles. Both
# thresholds are INDEPENDENT of, and ADDITIVE to, the per-task retry/iteration
# bounds in #138/#133 — the breaker trips on its own cap and never resets them.
# A tripped PBI stays halted: no further minutes are counted or trips emitted,
# so no additional cost is incurred after the trip.
#
# Cap on cumulative worker-minutes for one PBI (default 60). When the sum of
# all that PBI's worker-task durations reaches this, work halts and a
# circuit-breaker-tripped event (machine-readable) is emitted. Positive integer.
# MINIMUM: 1 (lower values throw). MAXIMUM: 10080 (7 days). Values outside this
# or non-integer strings throw.
DF_MAX_WORKER_MINUTES_PER_PBI=
# Minimum duration threshold: sub-second tasks (< 5000ms) are discarded to
# prevent Math.ceil exploitation (1 second rounds to 1 minute). Default: 5000.
DF_MIN_DURATION_MS=
# Cap on total trip events per PBI to prevent DoS attacks via event flooding.
# Default: 100. After this limit, additional trip events are silently dropped.
DF_MAX_TRIPS_PER_PBI=
# Number of failed self-correct cycles (CI fail -> re-dispatch -> fail) that
# triggers escalation to a human (default 3). A success before the threshold
# resets the failure count for that PBI. Positive integer. MINIMUM: 1 (lower
# values throw).
DF_MAX_FAILED_SELFCORRECT=
#
# === INPUT SANITIZATION ===
# All the above env values are validated at runtime. The breaker validates:
# - Numeric strings must be pure integers (no decimals, no alphanumeric mix)
# - Values must be within documented ranges (fail-closed on violation)
# - PII IDs must match pattern: letter followed by alphanumeric/_/- (NO periods)
# Malicious input is rejected with EnvConfigError - never silently coerced.

# ---------------------------------------------------------------------------
# Dark Factory R3 — Developer Agent (#133)
# ---------------------------------------------------------------------------
#
# Limits for the Developer Agent's TDD coding loop. These prevent runaway
# AI writes consuming excessive compute or time. Values must be positive
# integers; non-numeric strings throw ValidationError.
#
# Default iteration cap for the Developer Agent's TDD coding loop (default: 10
# when unset or empty). Read by createDeveloperAgent() unless the caller passes
# an explicit maxIterations. When the cap is reached without the tests passing,
# the loop STOPS and reports status='failed' — it never hangs indefinitely.
# Cap on coding-loop iterations (DF). Positive integer, DIGITS ONLY
# (e.g. 10). Forms like "1e3" or "0x10" are rejected, not coerced. Any other
# value throws InvalidTaskError at agent construction time (fail-closed) rather
# than silently running unbounded.
DF_MAX_ITERATIONS=
#
# Soft target for total worker minutes per delegated task (default: 15).
# Used ONLY as a planning heuristic for task-complexity estimation. It is NOT
# enforced by the Developer Agent seam: exceeding it does NOT abort, slow down,
# or fail the task, and no code currently reads this value.
DF_MAX_WORKER_MINUTES_PER_TASK=15

# ---------------------------------------------------------------------------
# Dark Factory R5 — Definition of DONE (#164)
# ---------------------------------------------------------------------------
#
# Maximum number of automated review -> fix rounds before halting (default: 3).
# When the budget is exhausted and unresolved review findings remain, the task
# halts immediately and transitions to df:blocked / needs-answer for human triage.
# Recurring findings count against this budget (no reset).
# Digits only (e.g. 3). Values like "1e3", "-1", "0" throw InvalidConfigurationError.
DF_MAX_REVIEW_ROUNDS=

# ---------------------------------------------------------------------------
# Dark Factory R4a — Self-Improvement Controller (#146)
# ---------------------------------------------------------------------------
#
# The controller that closes the factory's self-improvement loop: it observes
# the #140 metrics, proposes a bounded change to a tunable surface, applies it
# behind a versioned reversible handle, re-measures against a fixed benchmark,
# and keeps the change ONLY if the objective improved and no guardrail
# regressed. Otherwise it reverts and records the rejection.
#
# All three below are CONFIG, not secrets.
#
# Master switch. Unset/empty means DISABLED — the controller is inert and every
# cycle NO-OPs with reason "disabled" (fail-closed: an operator opts IN).
# Accepted: 1/true/0/false. Anything else throws SelfImprovementConfigError
# rather than guessing.
DF_SELFIMPROVE_ENABLED=
#
# Required gain in the objective metric (success rate per task type) before a
# change is accepted. Default 0 = any improvement is enough; an unchanged
# objective is still rejected. Plain digits with an optional decimal part
# (e.g. 0.05) — "1e3" and "-1" throw SelfImprovementConfigError.
DF_SELFIMPROVE_OBJECTIVE_TOLERANCE=0
#
# Allowed regression in a guardrail (mean iterations / mean fix cycles) before
# the change is rejected. Default 0 = no guardrail may get worse. Same
# digits-only validation as above.
DF_SELFIMPROVE_GUARDRAIL_TOLERANCE=0
#
# Minimum minutes between self-improvement cycles (default: 1440 = daily).
# Cadence is a DECISION the caller's scheduler makes, not an in-process timer: a
# serverless function cannot host a long-lived loop, so isCycleDue() reads a
# persisted watermark instead. Positive integer, digits only — "0", "1e3" and
# "-5" throw SelfImprovementConfigError.
DF_SELFIMPROVE_INTERVAL_MINUTES=1440

# ---------------------------------------------------------------------------
# Webhook signature enforcement (#78)
# ---------------------------------------------------------------------------
#
# Whether this deployment REQUIRES a valid x-hub-signature-256 on GitHub
# webhook deliveries. The default is DENY for any production build — including
# self-hosted ones — because the gate used to be keyed on VERCEL_ENV alone, so a
# self-hosted deployment (NODE_ENV=production, VERCEL_ENV unset) silently
# accepted unsigned, forgeable payloads.
#
# Effective default, when neither variable below is set:
#   - Vercel production, or any other production build  -> signatures REQUIRED
#   - Vercel preview                                     -> permissive (evals post unsigned)
#   - local development (NODE_ENV=development)           -> permissive
# Whenever a webhook secret IS configured, signatures are verified regardless.
#
# Force enforcement on ANY environment (including preview and local dev). Set
# this on a self-hosted deployment to be certain, even if NODE_ENV differs.
REQUIRE_WEBHOOK_SIGNATURE=
#
# DANGEROUS — explicitly accept unsigned webhooks on a production build. This
# exists so an operator who genuinely wants an open endpoint says so on purpose
# instead of by omission. Never set it on a deployment that holds real data.
# A warning is logged whenever the permissive path is taken.
ALLOW_UNSIGNED_WEBHOOKS=
