# Copy this file to `.env.local` and fill in the values.
# `cp .env.example .env.local`
#
# Only `.env.example` is committed. Never commit a real `.env.local` —
# `.gitignore` excludes every `.env*` file except this one.
#
# In production these are set as Vercel environment variables
# (Project Settings -> Environment Variables), NOT in a file. Sensitive
# values are masked in Vercel and cannot be read back with `vercel env pull`.

# ---------------------------------------------------------------------------
# GitHub integration
# ---------------------------------------------------------------------------

# Personal access token used to write to the repository.
#
# Required permissions — BOTH are needed:
#   - Contents: Read and write   (Release Manager writes `releasenotes.md`)
#   - Issues:   Read and write   (Product Owner creates story issues and posts
#                                 clarifying comments)
#
# A Contents-only token returns HTTP 403 when creating issues or comments.
#
# Classic PAT: `public_repo` covers both on a public repository
#              (`repo` for private repositories).
# Fine-grained PAT: select BOTH "Contents: Read and write" AND
#              "Issues: Read and write" — they are separate entries and
#              selecting only Contents is the usual mistake.
#
# Verify before deploying (does not print the token, only its scopes):
#   curl -sI -H "Authorization: Bearer $GH_RELEASE_TOKEN" \
#        https://api.github.com/rate_limit | grep -i x-oauth-scopes
# A fine-grained PAT returns a 200 with no `x-oauth-scopes` header; check it
# under GitHub -> Settings -> Developer settings -> Fine-grained tokens.
GH_RELEASE_TOKEN=

# Token the Product Owner uses to CREATE `[Story]` issues (and post the
# cross-reference comment on the source issue). Read BEFORE GH_RELEASE_TOKEN
# and GITHUB_TOKEN — so a story-only token can be scoped to `issues: write`
# without granting repo Contents access. Needs `issues: read and write`.
GH_STORY_TOKEN=

# Final fallback token if neither GH_RELEASE_TOKEN nor GH_STORY_TOKEN is set.
# SAME permission requirements as GH_RELEASE_TOKEN above.
GITHUB_TOKEN=

# Optional env override for the default publish target. When set, story
# publishing falls back to this owner/repo if the webhook payload does not
# supply an explicit source owner/repo. Must be a clean GitHub identifier
# (alphanumerics, hyphens for owner; alphanumerics, `.`, `_`, `-` for repo).
# If the env value is stripped to empty by sanitisation, the literal default
# "ricardoblackskye" / the webhook-supplied value is used instead (a warning
# is emitted so a misconfiguration is not silent).
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Comma-separated allow-list of `owner/repo` targets that story publishing is
# PERMITTED to write to. CONFIG (not a secret) — values are public repo names.
#
# FAIL-CLOSED: if this is unset or empty, publishing is REFUSED with zero API
# calls (mode: "blocked"). A misconfigured/unconfigured deployment therefore
# cannot silently publish to an arbitrary repo. Comparison is
# case-insensitive on BOTH owner and repo (GitHub treats both as
# case-insensitive).
#
# Example (the two repos this agent is currently allowed to publish to):
#   STORY_ALLOWED_REPOS=ricardoblackskye/agent-eve,ricardoblackskye/WebFeedPOC
STORY_ALLOWED_REPOS=

# Shared secret that authenticates incoming GitHub webhook payloads.
# Must match the secret configured on the webhook in GitHub repo Settings.
#
# REQUIRED in deployed environments. If this is unset on Vercel
# (VERCEL_ENV=production or preview), the webhook handler refuses to process
# requests and returns HTTP 500 — an unset secret previously bypassed
# signature verification and accepted forged payloads. Leaving it empty is
# only permitted for local development.
#
# Also needed as a GitHub Actions SECRET (not a variable) for the
# production-evals job: production rejects unsigned webhooks with 401, so the
# eval suite signs its requests with this value. Without it those evals skip
# the happy-path webhook assertions rather than fail.
GH_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Agent runtime
# ---------------------------------------------------------------------------

# Bearer token required by the Eve API. When unset the agent falls back to
# local dev / OIDC auth.
EVE_API_KEY=

# OpenRouter key powering the model. When unset the agent falls back to a
# deterministic mock model so local development and evals need no key.
OPENROUTER_API_KEY=

# Optional: override the root chat model id (defaults to deepseek/deepseek-v4.1-flash).
EVE_CHAT_MODEL=deepseek/deepseek-v4.1-flash

# Optional: model id used by subagents that resolve their own model (the
# Sprint Metrics Analyst and the PR-reviewer GitHub Action). Defaults to
# deepseek/deepseek-v4.1-flash when unset. CONFIG (not a secret).
MODEL_NAME=deepseek/deepseek-v4.1-flash

# Client-side Eve API key for the chat widget.
#
# WARNING — PUBLIC BY DESIGN, NOT A SECRET. Any NEXT_PUBLIC_* variable is
# inlined into the browser JavaScript bundle and is readable by anyone who
# visits the site. Do NOT mark this Sensitive and do NOT reuse a key that
# protects anything beyond this proxy.
#
# What it actually is: the key the chat UI sends as `Authorization: Bearer <key>`
# to YOUR OWN `/api/eve` proxy. That proxy requires `Bearer ${EVE_API_KEY}`
# to even reach the agent (app/api/eve/v1/[...slug]/route.ts), so in practice
# this value must EQUAL the server-side EVE_API_KEY for the widget to work.
# It does NOT grant GitHub or OpenRouter access — an extracted key only lets a
# visitor call your own deployed agent through your own proxy (your compute +
# OpenRouter quota). Mitigate abuse with proxy rate-limiting and Vercel
# Protection, not key separation.
NEXT_PUBLIC_EVE_API_KEY=

# ---------------------------------------------------------------------------
# Vercel
# ---------------------------------------------------------------------------

# Vercel Protection Bypass secret. When a deployment uses Vercel Protection
# (password / SSO / signed-bypass), this header value lets server-to-server
# calls (e.g. the proxy route, evals against the deployed URL) reach the app.
# SECRET — mark Sensitive in Vercel. Leave empty for unprotected deployments.
VERCEL_PROTECTION_BYPASS=

# ---------------------------------------------------------------------------
# Optional: user-story generation overrides
# ---------------------------------------------------------------------------

# Mention that triggers the Product Owner when it appears in a new issue body.
EVE_STORY_MENTION=@eve-agent

# Label that triggers the Product Owner when applied to an issue.
EVE_STORY_LABEL=needs-story

# ---------------------------------------------------------------------------
# Sprint Metrics Report (label an issue `generate-sprint-report`)
# ---------------------------------------------------------------------------

# Token the Sprint Metrics Analyst uses to READ the GitHub Projects V2 board.
# Needs the `read:project` scope (classic PAT) or "Projects: read-only" fine-
# grained permission. SECRET — mark Sensitive in Vercel. If unset, the report
# step falls back to GH_RELEASE_TOKEN / GITHUB_TOKEN.
GH_SPRINT_TOKEN=

# Override the Projects V2 board the report reads. Defaults to the user
# project `ricardoblackskye` #3.
SPRINT_PROJECT_OWNER=ricardoblackskye
SPRINT_PROJECT_NUMBER=3

# ---------------------------------------------------------------------------
# CI / PR reviewer (GitHub Actions)
# ---------------------------------------------------------------------------

# Optional: cap on the diff characters sent to the PR-reviewer LLM
# (scripts/pr-reviewer.js). Defaults to 20000 when unset. Raise for very large
# PRs, lower to cut token cost. CONFIG (not a secret).
PR_REVIEW_MAX_DIFF_CHARS=20000

# Optional: total completion budget for the PR-reviewer call. Must comfortably
# exceed PR_REVIEW_REASONING_MAX_TOKENS so a full review fits AFTER the model
# finishes its reasoning. Defaults to 6000. CONFIG (not a secret).
PR_REVIEW_MAX_TOKENS=6000

# Optional: HARD cap on reasoning tokens. `reasoning.effort` alone is a hint a
# reasoning model may exceed; without a token cap the model can spend the whole
# budget thinking and return empty content, silently degrading the review to a
# structural stub (#87). Defaults to 1500.
PR_REVIEW_REASONING_MAX_TOKENS=1500

# ---------------------------------------------------------------------------
# Dark Factory R1 — state, dispatch, observability (#134 / #138 / #140)
# ---------------------------------------------------------------------------
#
# Eve is stateless between requests, so the delivery loop keeps its execution
# memory in an EXTERNAL store. These knobs are fail-closed: an unset driver
# makes the seam REFUSE rather than pretend it persisted anything.
#
# Execution-memory store (current issue, assigned worker, last test outcome,
# delivery-loop step). Unset -> refusing `console` default. `sqlite` ->
# file-backed adapter. Any other value is a configuration error.
DF_STATE_DRIVER=
# Required when DF_STATE_DRIVER=sqlite: filesystem path to the SQLite file.
# A Vercel serverless filesystem is ephemeral, so this proves real external-
# state semantics locally and in CI but does NOT survive cold starts;
# production persistence needs Redis/pgvector (a later release).
DF_STATE_DB_PATH=
# Optional sandbox root (defence in depth). When set, DF_STATE_DB_PATH must
# resolve INSIDE this directory — an escaping path is refused at boot rather
# than silently used (same fail-closed shape as STORY_ALLOWED_REPOS). Unset
# trusts the operator, who already controls the environment.
DF_STATE_DB_DIR=
# Dispatch retry policy. Defaults: 2 retries, 1000ms base delay, x3 backoff.
# Values must be integers >= 0 — a malformed value is rejected, not defaulted.
DF_DISPATCH_MAX_RETRIES=
DF_DISPATCH_BASE_DELAY_MS=
# Observability store. Unset or `memory` -> in-process store. Failed writes are
# surfaced and buffered for retry, never dropped silently.
DF_METRICS_DRIVER=

# ---------------------------------------------------------------------------
# Dark Factory R2 — worker environment + credential boundary (#135 / #142)
# ---------------------------------------------------------------------------
#
# Where the worker sandbox runs. Unset or `local` -> the R2 dry-run provider,
# which reports isolated:false and executes NOTHING (it reports what it would
# do). The e2b/modal adapters land once keys exist; any other value is rejected.
DF_WORKER_PROVIDER=
# Repos a worker task may target (comma-separated `owner/repo`). FAIL-CLOSED:
# unset means NO repo is permitted and every task is refused with 403 BEFORE a
# sandbox is provisioned. Deliberately kept separate from STORY_ALLOWED_REPOS so
# the two blast radii stay independent.
DF_WORKER_ALLOWED_REPOS=
# Runtime requested inside the worker environment: `node` | `python` (default node).
DF_WORKER_RUNTIME=
# Lifetime of the per-task credential lease in seconds (1..3600, default 3600).
# The worker receives a LEASE only; the repository token stays in the broker.
DF_CREDENTIAL_TTL_SECONDS=
